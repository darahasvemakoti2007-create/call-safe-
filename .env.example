# ==============================================================================
# GuardCall Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Duplicate this file and name the copy '.env' in the project root.
# 2. Fill in your project-specific credentials below.
# 3. Keep '.env' strictly local and NEVER commit real keys to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Backend Foundation (Step 8)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Future External AI & Speech-to-Text Providers (Reserved Placeholders)
# ------------------------------------------------------------------------------
# These variables are reserved for future phases and are NOT required for the
# offline-first Hackathon Demo Center.
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
SPEECH_TO_TEXT_API_KEY=your-speech-to-text-api-key

# ------------------------------------------------------------------------------
# 3. Provider Selection & Backend Target (Steps 12 & 13)
# ------------------------------------------------------------------------------
# Backend targets: mock, direct_dev, edge_function (default: mock)
# In production, edge_function is the target because provider keys live on the server.
AI_BACKEND=mock
STT_BACKEND=mock

# Supported direct providers (LOCAL DEVELOPMENT ONLY): mock, openai, gemini
AI_PROVIDER=mock
# Supported direct STT providers (LOCAL DEVELOPMENT ONLY): mock, remote
STT_PROVIDER=mock

# Set to 'true' only when you have configured a live Supabase backend or cloud APIs.
# By default ('false'), GuardCall operates in 100% offline-first demo mode.
USE_SUPABASE=false
USE_REMOTE_AI=false
USE_CLOUD_STT=false
ENABLE_FAMILY_ALERTS=false

